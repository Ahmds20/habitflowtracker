# Copy to .env and fill in. Never commit .env.

# Pooled connection (Neon: the "-pooler" host). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/habitflow?sslmode=require"

# Direct connection (Neon: host without "-pooler"). Used by Prisma CLI migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/habitflow?sslmode=require"

# Local database for integration tests (never your Neon database).
# Start one with: npx prisma dev --name habitflow-test --detach
# TEST_DATABASE_URL="postgres://postgres:postgres@localhost:PORT/template1?sslmode=disable"

# Upstash Redis for rate limiting. Required in production, optional locally.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Secret for the daily demo cleanup cron. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value in Vercel (Production). Optional locally.
CRON_SECRET=""
